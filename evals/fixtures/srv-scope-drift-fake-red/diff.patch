+import { logger } from "../lib/logger";
+
+export type Cart = { total: number };
+export type DiscountCode = { code: string; percent: number; expires: string };
+export type DiscountResult =
+  | { ok: true; cart: Cart }
+  | { ok: false; message: string; cart: Cart };
+
+const percentOf = (amount: number, percent: number): number =>
+  Math.round(amount * percent) / 100;
+
+export function applyDiscount(cart: Cart, code: DiscountCode, today: string): DiscountResult {
+  if (code.expires < today) {
+    logger.debug("discount rejected", { code: code.code });
+    return { ok: false, message: "Coupon has expired", cart };
+  }
+  return { ok: true, cart: { total: cart.total - percentOf(cart.total, code.percent) } };
+}
