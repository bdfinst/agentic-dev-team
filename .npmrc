# Enforce the engines floor (package.json -> engines.node ">=22"). Without this,
# npm only warns on an old Node; engine-strict makes `npm ci`/`npm install` fail,
# so every environment (local, CI, cloud) actually runs at least Node 22.
# CI still provisions the .nvmrc version (24); the floor is the minimum a
# contributor's machine or a cloud container needs, not the version CI pins.
engine-strict=true
