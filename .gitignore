.DS_Store

# Conversation summaries (generated at runtime)
.claude/memory/*.md

# Performance logs (generated at runtime)
.claude/metrics/*.json
.claude/metrics/*.log

# EnterWorktree tool scratch dirs (per-agent git worktrees, not repo content)
.claude/worktrees/

# Runtime metrics logs — leading **/ so they match whether hooks write to the
# repo-root metrics/ or plugins/dev-team/metrics/ (cwd-dependent) — #1081.
# Session-review trend digest (per-run runtime data; consumed locally — #129)
**/metrics/session-digest.jsonl
# Opt-in telemetry beacon event log (local-only; never checked in — #135)
**/metrics/telemetry.jsonl
# Per-checkpoint review-value meter (runtime data; counts-only — #348)
**/metrics/review-value.jsonl
# Per-slice /verify evidence log (runtime data; counts-only — #727)
**/metrics/verify-log.jsonl
# Boundary-level policy-gateway event log (runtime data; rule-IDs-only — #859)
**/metrics/boundary-events.jsonl

# Effort-band model routing (per-user, never checked in)
# - ladder: optional ordered model list (.claude/model-ladder.json), hand-written by users behind restricted endpoints
# - session model: captured at SessionStart for dispatch fallback + upgrade flags
# - bump log: append-only JSONL recording routing bumps from the dispatch hook
.claude/model-ladder.json
.claude/session-model
.claude/metrics/model-routing.log
UPDATE.md

sync-to-aci.sh

# Per-pair fingerprint replay cache for the live eval gate (#311). Generated at
# runtime; restored/uploaded as a CI workflow artifact per branch, never checked in.
evals/.eval-cache.json

# /code-review benchmark harness output (#821) — results.jsonl, skipped.jsonl,
# raw dispatch output, report.md. Generated by evals/code-review-benchmark/cli.py.
evals/code-review-benchmark/results/

# /code-review benchmark harness's auto-provisioned dataset homes (#949) —
# Defects4J framework checkout + BugsJS/bug-dataset clone, cloned on demand
# by evals/code-review-benchmark/adapters/bootstrap.py.
evals/code-review-benchmark/.cache/

# Pre-commit review gate file (generated at runtime)
.review-passed
feature-file-validation-workspace/

# Repo-local pinned PMD distribution (installed by
# scripts/install-java-static-analysis.py; large JVM binaries, never committed)
.pmd/

# Python caches
__pycache__/
*.py[cod]
*.pyo

# Repowise codebase-documentation MCP cache (session counters, wiki/omissions
# sqlite dbs) — local tool state, regenerated per session, never committed.
.repowise/

# Graphify knowledge-graph output — a large, generated per-repo artifact.
# Built on demand (`graphify extract .`); the committed CLAUDE.md section +
# .claude hooks take over once graphify-out/graph.json exists.
graphify-out/
# Graphify's git hooks embed a machine-specific Python path, so they're
# generated per-clone by `graphify hook install` (run from dev-setup.sh), not
# committed — like .git/hooks. The portable wiring under .claude/ IS committed.
.husky/post-commit
.husky/post-checkout
# Graphify's merge-driver .gitattributes is written per-clone by `graphify hook
# install` (points at the gitignored graphify-out/graph.json), so it's not committed.
.gitattributes

# Calibration runtime output (`/agent-eval --calibrate`). Timestamped reports
# are regeneratable; calibration-records.json is (re)written per run and the
# report is published to the issue, not committed — the tracked baseline has no
# records file (every target "never-calibrated"). Un-ignore records only if a
# deliberate baseline run is meant to commit them.
.claude/evals/reports/
# calibration-records.json is un-ignored for the deliberate #1184 baseline
# handoff (see note above): the run completes on a local machine and commits its
# canonical records back to this branch. Under baseline-1184/, only the
# regeneratable reports/ and atomic *.tmp write-scratch stay ignored; the
# cells/samples/verdicts checkpoint plus the driver and resume script travel via git.
.claude/evals/baseline-1184/reports/
.claude/evals/baseline-1184/*.tmp

