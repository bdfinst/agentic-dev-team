#!/usr/bin/env sh
# pre-push — run the local mirror of GitHub CI, then optionally the paid,
# diff-scoped live agent-eval.
#
#   1. scripts/ci-local.sh   — the deterministic CI gates (always; blocks push).
#   2. scripts/eval-changed.sh — the live agent-eval, scoped to changed
#      agents/skills, but only after you opt in at the prompt below.
#
# Set HUSKY_RUN_EVALS=1 to auto-run the evals (no prompt), =0 to always skip.
# Set HUSKY=0 to bypass the whole hook (git's standard escape hatch).

# Resolve the push range from git's stdin lines:
#   <local ref> <local sha> <remote ref> <remote sha>
# remote sha is all-zero for a brand-new branch; local sha is all-zero for a
# branch deletion (which we skip).
BASE=""
HEAD=""
PUSH_REF=""
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in *[!0]*) : ;; *) continue ;; esac  # all-zero => deletion
  HEAD="$local_sha"
  PUSH_REF="$local_ref"
  case "$remote_sha" in
    *[!0]*) BASE="$remote_sha" ;;                          # existing remote branch
    *) BASE="$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null || true)" ;;
  esac
  break
done

# Fallbacks (e.g. a client that feeds no stdin): diff against the main base.
[ -z "$HEAD" ] && HEAD="$(git rev-parse HEAD 2>/dev/null || true)"
[ -z "$BASE" ] && BASE="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || true)"

# 1. Deterministic CI mirror — blocks the push on failure.
# Wrapped in a ref-integrity guard (issue #546): if any refs/heads/* changes
# during ci-local's execution (because of a fixture bats bug or any other
# reason), refuse the push loudly instead of proceeding on corrupted local
# state. POSIX sh only — no [[, no arrays, no process substitution.
PRE_REFS_FILE="$(mktemp -t prepush-refs-pre-XXXXXX)"
POST_REFS_FILE="$(mktemp -t prepush-refs-post-XXXXXX)"
EXEMPT_REFS_FILE="$(mktemp -t prepush-refs-exempt-XXXXXX)"
DRIFT_FILE="$(mktemp -t prepush-refs-drift-XXXXXX)"
PRE_WORKTREE_PATHS_FILE="$(mktemp -t prepush-worktree-paths-pre-XXXXXX)"
trap 'rm -f "$PRE_REFS_FILE" "$POST_REFS_FILE" "$EXEMPT_REFS_FILE" "$DRIFT_FILE" "$PRE_WORKTREE_PATHS_FILE"' EXIT
git for-each-ref --format='%(refname) %(objectname)' refs/heads/ > "$PRE_REFS_FILE"
SELF_REF="$(git symbolic-ref -q HEAD 2>/dev/null || true)"
# This worktree's own path, captured before ci-local runs (issue #1945): the
# structural counterpart to $SELF_REF below. $SELF_REF is a *branch name*
# snapshotted pre-run, so if ci-local's execution leaves this worktree
# checked out on a *different* branch than it started on, $SELF_REF no
# longer names that branch and can't filter it out downstream. $selfwt is a
# *path*, and this worktree's path doesn't change just because its checked-
# out branch does — passing it into the exemption-computation awk lets that
# awk exclude this worktree structurally (by path), not just via the
# post-hoc $SELF_REF string filter.
SELF_WORKTREE_PATH="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# Snapshot worktree paths before ci-local runs (issue #1871 fix, step 1 of 2):
# a worktree created *during* the hook's multi-minute run window must not be
# able to self-enroll in the exemption below. Use sub() to strip only the
# fixed "worktree " prefix rather than default $1/$2 field-splitting — a
# worktree path may legitimately contain a space (unlike a branch refname,
# which git forbids from containing one), and default field-splitting would
# truncate such a path at the first space.
git worktree list --porcelain 2>/dev/null | awk '/^worktree /{sub(/^worktree /, ""); print}' > "$PRE_WORKTREE_PATHS_FILE"

echo "pre-push: running local CI mirror (scripts/ci-local.sh)…"
# `|| true` so a non-zero exit from ci-local doesn't trip husky's `sh -e`
# before we can capture the code and run the ref-integrity check.
CI_EXIT=0
bash scripts/ci-local.sh "$BASE" "$HEAD" || CI_EXIT=$?

git for-each-ref --format='%(refname) %(objectname)' refs/heads/ > "$POST_REFS_FILE"

# Branches checked out in *other* worktrees of this clone are outside this
# hook's blast radius (issue #1815). All worktrees share one ref store, and
# ci-local runs for minutes, so a sibling session that commits, rebases, or
# resets during that window legitimately moves its own branch — concurrency,
# not corruption.
#
# Path-intersection model (issue #1871, step 2 of 2) — supersedes the
# earlier ref-name-only match this comment used to describe: a worktree's
# branch is exempt only if that worktree's *path* was already present in the
# pre-run snapshot ($PRE_WORKTREE_PATHS_FILE, captured before ci-local ran —
# see step 1 above). Ref-name matching alone let a worktree *created* during
# the hook's multi-minute run window self-enroll and exempt any ref it
# grabbed. Path-string equality between the pre-run and post-run snapshots is
# safe here despite this hook's earlier reasoning against path-based ref
# matching in a different context: both snapshots come from the same-shape
# `git worktree list --porcelain` invocation within one hook execution, so no
# cross-process/cross-tool path-normalization boundary (e.g. /tmp vs.
# /private/tmp) is crossed the way a user-supplied or externally-sourced path
# might cross one.
#
# Known, accepted limitation: the join key is worktree *path*, not a stable
# per-worktree identity (porcelain output exposes none) — a worktree removed
# and recreated at an *identical* pre-existing path during the hook window
# inherits exemption even though it is a different worktree
# (see test_guard_worktree_recreated_at_same_path_is_exempt_known_limitation).
# Conversely, a pre-existing worktree *relocated* via `git worktree move`
# mid-hook is conservatively treated as blocking, since its new path was
# never in the pre-run snapshot
# (see test_guard_worktree_moved_mid_hook_is_conservatively_blocking) — the
# safe direction for a guard whose failure mode to avoid is a false
# negative, not a false positive.
#
# Third known, accepted limitation: this join key (path) also can't detect a
# *sibling* worktree that switches to an arbitrary different branch mid-hook
# — the sibling's path stays in the pre-run snapshot, so whatever branch it
# ends up on still reads as a legitimate, non-blocking "sibling worktree
# moved during the hook" note rather than being independently judged.
# Closing that fully would need snapshotting (path, branch) pairs instead of
# paths alone — a bigger redesign, out of scope here. This worktree's own
# path is excluded structurally below (via $selfwt), so this limitation is
# scoped to sibling worktrees only, not this one.
#
# The ref being pushed and this worktree's own HEAD are never exempt. This
# worktree's own path is excluded from ever contributing an exemption
# (path_pre_existing forced to 0 when path == selfwt) regardless of which
# branch it ends up checked out on post-run — the downstream `-e "$SELF_REF"`
# grep filter below is a second layer of defense, not the only guard.
git worktree list --porcelain 2>/dev/null | awk -v prefile="$PRE_WORKTREE_PATHS_FILE" -v selfwt="$SELF_WORKTREE_PATH" '
    BEGIN {
      while ((getline line < prefile) > 0) { pre_paths[line] = 1 }
      close(prefile)
    }
    /^worktree / {
      path = $0
      sub(/^worktree /, "", path)
      path_pre_existing = (path in pre_paths) && (selfwt == "" || path != selfwt)
      next
    }
    $1 == "branch" && path_pre_existing { print $2 }
  ' | grep -v -x -F -e "$PUSH_REF" -e "$SELF_REF" > "$EXEMPT_REFS_FILE" || true

if ! cmp -s "$PRE_REFS_FILE" "$POST_REFS_FILE"; then
  # Emit each changed ref with pre / post SHA, classified as blocking or
  # sibling-owned. Build the exempt set and a pre-map, then walk the post-map
  # to detect mutation and creation; walk the pre-map for deletions. awk exits
  # non-zero when at least one blocking ref drifted.
  awk '
    function report(ref, line) {
      if (ref in exempt) { sibling = sibling line "\n" }
      else { blocking = blocking line "\n"; blocked = 1 }
    }
    FILENAME == ARGV[1] { exempt[$1]=1; next }
    FILENAME == ARGV[2] { pre[$1]=$2; next }
    {
      post[$1]=$2
      if (!($1 in pre)) {
        report($1, sprintf("  %s: pre=<absent> post=%s (created)", $1, $2))
      } else if (pre[$1] != $2) {
        report($1, sprintf("  %s: pre=%s post=%s", $1, pre[$1], $2))
      }
    }
    END {
      for (ref in pre) {
        if (!(ref in post)) {
          report(ref, sprintf("  %s: pre=%s post=<absent> (deleted)", ref, pre[ref]))
        }
      }
      if (blocked) {
        printf "\npre-push: ABORT — refs/heads/* changed during hook execution.\n"
        printf "This usually means a fixture test corrupted your local refs. See issue #546.\n\n"
        printf "%s", blocking
        printf "\nRecover from your reflog:\n"
        printf "  git update-ref <refname> <pre-sha>       # for mutated / deleted refs\n"
        printf "  git update-ref -d <refname>              # for stray created refs\n"
        printf "\nIf a concurrent worktree operation caused this, no recovery is needed —\n"
        printf "let it settle and retry the push.\n"
      }
      if (sibling != "") {
        printf "\npre-push: note — branches owned by sibling worktrees moved during the\n"
        printf "hook. Not corruption, not blocking:\n"
        printf "%s", sibling
      }
      exit (blocked ? 1 : 0)
    }
  ' "$EXEMPT_REFS_FILE" "$PRE_REFS_FILE" "$POST_REFS_FILE" > "$DRIFT_FILE" || DRIFT_BLOCKED=1
  cat "$DRIFT_FILE" >&2
  [ "${DRIFT_BLOCKED:-0}" = 1 ] && exit 1
fi

# Refs stable — honor ci-local's exit code (existing behavior).
[ "$CI_EXIT" -ne 0 ] && exit "$CI_EXIT"

# 2. Opt-in live agent-eval, diff-scoped to changed agents/skills.
answer=n
case "${HUSKY_RUN_EVALS:-}" in
  1) answer=y ;;
  0) answer=n ;;
  *)
    # Detect a *usable* controlling terminal. `[ -r /dev/tty ]` only checks the
    # permission bits, which pass even from GUI git clients (VS Code, JetBrains)
    # where there is no tty — writing then fails with "Device not configured"
    # and aborts the hook under `sh -e`. Test-open it instead.
    #
    # `true`, NOT `:` — they are interchangeable everywhere except here. `:` is
    # a POSIX *special* builtin, and a redirection error on a special builtin
    # is fatal to a non-interactive shell: the probe that exists to detect a
    # missing tty would itself kill the hook with exit 2 in precisely the
    # environment it is meant to handle. `true` is a regular builtin, so the
    # failed redirection just yields a non-zero status the `if` can read.
    if { true > /dev/tty; } 2>/dev/null; then
      printf '\nRun live agent-evals for changed agents/skills? (costs API tokens) [y/N] ' > /dev/tty
      read -r answer < /dev/tty || answer=n
    else
      echo "pre-push: no controlling terminal; skipping live agent-eval (set HUSKY_RUN_EVALS=1 to force, or run evals via 'npm run eval:changed')."
    fi
    ;;
esac

case "$answer" in
  [Yy]*) bash scripts/eval-changed.sh "$BASE" "$HEAD" || exit 1 ;;
  *) echo "pre-push: skipped live agent-eval." ;;
esac

exit 0
