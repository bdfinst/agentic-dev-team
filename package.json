    "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.7",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
