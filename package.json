{
  "name": "agentic-dev-team",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for the dev-team Claude Code plugin marketplace (lint config for TypeScript eval fixtures).",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
