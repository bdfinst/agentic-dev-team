{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "mcp__*"
    ],
    "deny": ["Bash(rm *)", "Bash(git push *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/session-model-banner.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/telemetry.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/pre-tool-guard.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/contract-version-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/destructive-guard.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/pre-commit-review.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/pre-commit-knowledge-index.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/telemetry.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/verify-guard.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/bash-retry-guard.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/telemetry.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/context-ceiling-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/codegraph-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/codegraph-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/codegraph-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/agent-model-resolve.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/context-ceiling-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/js-fp-review.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/token-efficiency-review.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/eval-compliance-check.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/tdd-guard.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/knowledge-index.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/mutation-gate.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/version-check.sh"
          }
        ]
      },
      {
        "matcher": "mcp__codegraph__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/codegraph-turn-mark.sh"
          }
        ]
      }
    ],
    "SessionStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/session-learning-trigger.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": null,
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/cost-meter.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": null,
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/cost-meter.sh"
          }
        ]
      }
    ]
  }
}
