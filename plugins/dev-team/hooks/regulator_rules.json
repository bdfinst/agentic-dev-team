{
  "_doc": "Ordered rules, first match wins per segment. Fields: id, decision (allow|ask|deny), cmd (name or list), sub (git/gh subcommand), args_any (any argv word equals one), args_none (no argv word equals one), regex (on the joined argv), check (named Python predicate in bash_regulator.CHECKS), applies_to (agent_type globs; omit for every caller), subagents_only (true = never the main session), reason. Allow rules never match a segment that redirects to a file other than /dev/null. opts_re (every argv word starting with - must fully match it: an option allowlist). Allow rules never match an untrusted segment (env/xargs/exec wrappers, assignment prefixes, path-qualified commands, expansions, git global options).",
  "rules": [
    {
      "id": "deny-git-push-subagent",
      "decision": "deny",
      "cmd": "git",
      "sub": "push",
      "subagents_only": true,
      "reason": "Subagents do not push; the pr or ship skill pushes from the main session."
    },
    {
      "id": "reviewer-no-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": [
        "rm",
        "mv",
        "cp",
        "mkdir",
        "touch",
        "chmod",
        "tee",
        "pip",
        "pip3",
        "npm",
        "npx",
        "uv",
        "brew"
      ],
      "reason": "Review agents are read-only."
    },
    {
      "id": "reviewer-no-git-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": "git",
      "sub": [
        "add",
        "commit",
        "push",
        "checkout",
        "switch",
        "reset",
        "restore",
        "merge",
        "rebase",
        "stash",
        "clean",
        "cherry-pick",
        "revert",
        "tag"
      ],
      "reason": "Review agents are read-only."
    },
    {
      "id": "reviewer-no-file-write",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "check": "writes_file",
      "reason": "Review agents are read-only."
    },
    {
      "id": "engineer-test-and-lint",
      "decision": "allow",
      "applies_to": [
        "software-engineer"
      ],
      "cmd": [
        "pytest",
        "ruff",
        "eslint",
        "oxlint",
        "prettier",
        "tsc",
        "vitest",
        "jest",
        "mypy"
      ],
      "reason": "Test and lint commands for the build step."
    },
    {
      "id": "allow-readonly-basic",
      "decision": "allow",
      "cmd": [
        "ls",
        "pwd",
        "cat",
        "head",
        "tail",
        "wc",
        "echo",
        "printf",
        "true",
        "false",
        "test",
        "[",
        "which",
        "type",
        "stat",
        "basename",
        "dirname",
        "realpath",
        "date",
        "uname",
        "whoami",
        "id",
        "printenv",
        "diff",
        "cmp",
        "cut",
        "tr",
        "column",
        "jq",
        "grep",
        "egrep",
        "fgrep",
        "du",
        "df",
        "sleep",
        "wait"
      ],
      "reason": "Read-only utility."
    },
    {
      "id": "allow-find-readonly",
      "decision": "allow",
      "cmd": "find",
      "args_none": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-okdir",
        "-fprint",
        "-fprint0",
        "-fprintf",
        "-fls"
      ],
      "reason": "find without an action that changes files."
    },
    {
      "id": "allow-sed-readonly",
      "decision": "allow",
      "cmd": "sed",
      "check": "sed_is_safe",
      "reason": "sed print/delete/quit address or one safe substitution."
    },
    {
      "id": "allow-git-readonly",
      "decision": "allow",
      "cmd": "git",
      "sub": [
        "status",
        "log",
        "diff",
        "show",
        "rev-parse",
        "rev-list",
        "ls-files",
        "ls-tree",
        "blame",
        "describe",
        "shortlog",
        "cat-file",
        "merge-base",
        "name-rev",
        "check-ignore",
        "for-each-ref"
      ],
      "opts_re": "--?(?:n\\d*|\\d+|oneline|stat|numstat|shortstat|summary|name-only|name-status|short|long|porcelain(?:=v?\\d)?|graph|decorate|all|branches|tags|no-merges|merges|abbrev-commit|abbrev(?:=\\d+)?|abbrev-ref|symbolic-full-name|format=[\\w%.:,<>@ -]+|pretty=[\\w%.:,<>@ -]+|cached|staged|check|first-parent|reverse|since=\\S+|until=\\S+|author=\\S+|max-count=\\d+|diff-filter=[A-Za-z]+|show-toplevel|is-inside-work-tree|git-dir|verify|follow|full-name|exclude-standard|others|deleted|modified|stdin|[sbvqzlpuw]{1,4}|name|no-color|color|no-pager|stat=\\d+|unified=\\d+|U\\d+|M|C|find-renames|find-copies|no-patch|patch|oneline|date=\\w+|relative-date|count|line-number|files-with-matches|word-regexp|fixed-strings|ignore-case|-)",
      "reason": "git read."
    },
    {
      "id": "allow-git-branch-list",
      "decision": "allow",
      "cmd": "git",
      "sub": "branch",
      "check": "git_branch_only_lists",
      "reason": "git branch listing."
    },
    {
      "id": "allow-gh-readonly",
      "decision": "allow",
      "cmd": "gh",
      "regex": "^gh (pr|issue|run|release|repo|workflow) (view|list|status|checks|diff)( |$)",
      "opts_re": "--(?:json|jq|limit|state|label|author|assignee|repo|branch|base|head|search|comments|name-only|patch|stat|log|log-failed|job|workflow|status|event|user|color|interval|exit-status|required|web)|-[LRsSlAaBHqt]",
      "args_none": [
        "--web",
        "-w"
      ],
      "reason": "gh read."
    },
    {
      "id": "allow-test-runners",
      "decision": "allow",
      "regex": "^(python3?|uv run python3?) -m (pytest|ruff check)( |$)|^(npm|pnpm|yarn) (test|run (test|lint|typecheck))$",
      "opts_re": "--?(?:q|qq|v|vv|x|s|k|m|lf|ff|co|collect-only|no-header|disable-warnings|rA|ra|rf|rs|rx|rfE|tb=\\w+|maxfail=\\d+|durations=\\d+|no-cov|p)|--(?:select|ignore|statistics|show-fixes|no-cache|quiet|isolated|output-format=\\w+|exit-zero)|-q",
      "reason": "Test, lint, typecheck."
    },
    {
      "id": "allow-tsc-no-emit",
      "decision": "allow",
      "cmd": "tsc",
      "args_any": [
        "--noEmit"
      ],
      "opts_re": "--(?:noEmit|pretty|project|skipLibCheck)|-p",
      "reason": "Typecheck without emitting files."
    },
    {
      "id": "allow-repo-scripts",
      "decision": "allow",
      "regex": "^python3? (?!\\S*\\.\\.)(\\./)?(scripts|plugins/[\\w-]+/(scripts|hooks))/[\\w./-]+\\.py\\b",
      "reason": "Repo-owned Python scripts."
    }
  ]
}