{
  "_doc": "Ordered rules, first match wins per segment. Fields: id, decision (allow|ask|deny), cmd (name or list), sub (git/gh subcommand), args_any (any argv word equals one), args_none (no argv word equals one), regex (on the joined argv), check (named Python predicate in bash_regulator.CHECKS), applies_to (agent_type globs; omit for every caller), subagents_only (true = never the main session), reason. Allow rules never match a segment that redirects to a file other than /dev/null. opts_re (every argv word starting with - must fully match it: an option allowlist). Allow rules never match an untrusted segment (env/xargs/exec wrappers, assignment prefixes, path-qualified commands, expansions, git global options). not_applies_to (agent_type globs the rule never fires for). words_none_re (no argv word matches this regex).",
  "rules": [
    {
      "id": "deny-git-push-subagent",
      "decision": "deny",
      "cmd": "git",
      "sub": "push",
      "subagents_only": true,
      "reason": "Subagents do not push; the pr or ship skill pushes from the main session."
    },
    {
      "id": "reviewer-no-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": [
        "rm",
        "mv",
        "cp",
        "mkdir",
        "touch",
        "chmod",
        "tee",
        "pip",
        "pip3",
        "npm",
        "npx",
        "uv",
        "brew"
      ],
      "reason": "Review agents are read-only."
    },
    {
      "id": "reviewer-no-git-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": "git",
      "sub": [
        "add",
        "commit",
        "push",
        "checkout",
        "switch",
        "reset",
        "restore",
        "merge",
        "rebase",
        "stash",
        "clean",
        "cherry-pick",
        "revert",
        "tag"
      ],
      "reason": "Review agents are read-only.",
      "check": "git_reviewer_mutation"
    },
    {
      "id": "reviewer-no-file-write",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "check": "writes_file",
      "reason": "Review agents are read-only."
    },
    {
      "id": "engineer-test-and-lint",
      "decision": "allow",
      "applies_to": [
        "software-engineer"
      ],
      "cmd": [
        "pytest",
        "ruff",
        "eslint",
        "oxlint",
        "prettier",
        "tsc",
        "vitest",
        "jest",
        "mypy"
      ],
      "reason": "Test and lint commands for the build step."
    },
    {
      "id": "allow-readonly-basic",
      "decision": "allow",
      "cmd": [
        "ls",
        "pwd",
        "cat",
        "head",
        "tail",
        "wc",
        "echo",
        "printf",
        "true",
        "false",
        "test",
        "[",
        "which",
        "type",
        "stat",
        "basename",
        "dirname",
        "realpath",
        "date",
        "uname",
        "whoami",
        "id",
        "printenv",
        "diff",
        "cmp",
        "cut",
        "tr",
        "column",
        "jq",
        "grep",
        "egrep",
        "fgrep",
        "du",
        "df",
        "sleep"
      ],
      "reason": "Read-only utility."
    },
    {
      "id": "allow-find-readonly",
      "decision": "allow",
      "cmd": "find",
      "args_none": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-okdir",
        "-fprint",
        "-fprint0",
        "-fprintf",
        "-fls"
      ],
      "reason": "find without an action that changes files."
    },
    {
      "id": "allow-sed-readonly",
      "decision": "allow",
      "cmd": "sed",
      "check": "sed_is_safe",
      "reason": "sed print/delete/quit address or one safe substitution."
    },
    {
      "id": "allow-git-readonly",
      "decision": "allow",
      "cmd": "git",
      "sub": [
        "status",
        "log",
        "diff",
        "show",
        "rev-parse",
        "rev-list",
        "ls-files",
        "ls-tree",
        "blame",
        "describe",
        "shortlog",
        "cat-file",
        "merge-base",
        "name-rev",
        "check-ignore",
        "for-each-ref"
      ],
      "opts_re": "--(?:since|until|grep|author|committer|format|pretty|untracked-files|ignore-submodules|diff-filter|date|abbrev|unified|max-count|skip|sort|count|points-at|contains|merged|no-merged|always|is-ancestor|all-match|invert-grep|regexp-ignore-case|extended-regexp|ancestry-path|simplify-by-decoration|date-order|topo-order|author-date-order|left-right|boundary|children|parents|no-abbrev|raw|compact-summary|word-diff|ignore-all-space|ignore-space-change|exit-code|quiet|ignored|ahead-behind|branch|tags|heads|all|branches|remotes|cached|staged|check|oneline|stat|numstat|shortstat|summary|name-only|name-status|short|long|porcelain|graph|decorate|no-merges|merges|abbrev-commit|abbrev-ref|symbolic-full-name|first-parent|reverse|show-toplevel|is-inside-work-tree|git-dir|verify|follow|full-name|exclude-standard|others|deleted|modified|stdin|no-color|color|no-pager|no-patch|patch|find-renames|find-copies|relative-date|line-number|files-with-matches|word-regexp|fixed-strings|ignore-case|count|name|symbolic|verbose|list)(?:=.*)?|-[sbvqzlpuwrtomSGaA]{1,4}|-[LU][\\d,+-]*|-u[a-z]*|-n\\d*|-\\d+|-[MC]\\d*|-|--",
      "reason": "git read."
    },
    {
      "id": "allow-git-branch-list",
      "decision": "allow",
      "cmd": "git",
      "sub": "branch",
      "check": "git_branch_only_lists",
      "reason": "git branch listing."
    },
    {
      "id": "allow-gh-readonly",
      "decision": "allow",
      "cmd": "gh",
      "regex": "^gh (pr|issue|run|release|repo|workflow) (view|list|status|checks|diff)( |$)",
      "opts_re": "--(?:json|jq|limit|state|label|author|assignee|repo|branch|base|head|search|comments|name-only|patch|stat|log|log-failed|job|workflow|status|event|user|color|interval|exit-status|required|web)|-[LRsSlAaBHqt]",
      "args_none": [
        "--web",
        "-w"
      ],
      "reason": "gh read."
    },
    {
      "id": "allow-test-runners",
      "decision": "allow",
      "regex": "^python3? -m pytest( |$)|^(npm|pnpm|yarn) (test|run (test|lint|typecheck))$",
      "opts_re": "--?(?:q|qq|v|vv|x|s|k|m|lf|ff|collect-only|no-header|disable-warnings|rA|ra|rf|rs|rx|rfE|tb=\\w+|maxfail=\\d+|durations=\\d+|no-cov)|-m",
      "reason": "Run the project's tests (runs repo code by design; not for review agents).",
      "words_none_re": "^@|^-p|^-c",
      "not_applies_to": [
        "*-review",
        "plan-review-*"
      ]
    },
    {
      "id": "allow-ruff-check",
      "decision": "allow",
      "regex": "^(python3? -m )?ruff check( |$)",
      "args_any": [
        "--no-fix"
      ],
      "opts_re": "--(?:(?:select|ignore)(?:=[\\w,]+)?|statistics|show-fixes|no-cache|quiet|isolated|output-format=\\w+|exit-zero|no-fix)|-q|-m",
      "words_none_re": "^@|^-c",
      "not_applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "reason": "ruff check without applying fixes."
    },
    {
      "id": "allow-tsc-no-emit",
      "decision": "allow",
      "cmd": "tsc",
      "args_any": [
        "--noEmit"
      ],
      "opts_re": "--(?:noEmit|pretty|project(?:=[\\w./-]+)?|skipLibCheck)|-p",
      "reason": "Typecheck without emitting files (incremental builds still write; not for review agents).",
      "not_applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "args_none": [
        "false",
        "true"
      ],
      "words_none_re": "^@"
    },
    {
      "id": "allow-repo-scripts",
      "decision": "allow",
      "regex": "^python3? (?!\\S*\\.\\.)(\\./)?(scripts|plugins/[\\w-]+/(scripts|hooks))/[\\w./-]+\\.py(?= |$)",
      "reason": "Repo-owned Python scripts (run repo code by design; not for review agents).",
      "not_applies_to": [
        "*-review",
        "plan-review-*"
      ]
    }
  ]
}