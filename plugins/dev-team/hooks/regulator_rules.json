{
  "_doc": "Ordered rules, first match wins per segment. Fields: id, decision (allow|ask|deny), cmd (name or list), sub (git/gh subcommand), args_any (any argv word equals one), args_none (no argv word equals one), regex (on the joined argv), check (named Python predicate in bash_regulator.CHECKS), applies_to (agent_type globs; omit for every caller), subagents_only (true = never the main session), reason. Allow rules never match a segment that redirects to a file other than /dev/null.",
  "rules": [
    {
      "id": "deny-git-push-subagent",
      "decision": "deny",
      "cmd": "git",
      "sub": "push",
      "subagents_only": true,
      "reason": "Subagents do not push; the pr or ship skill pushes from the main session."
    },
    {
      "id": "reviewer-no-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": [
        "rm",
        "mv",
        "cp",
        "mkdir",
        "touch",
        "chmod",
        "tee",
        "pip",
        "pip3",
        "npm",
        "npx",
        "uv",
        "brew"
      ],
      "reason": "Review agents are read-only."
    },
    {
      "id": "reviewer-no-git-mutation",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "cmd": "git",
      "sub": [
        "add",
        "commit",
        "push",
        "checkout",
        "switch",
        "reset",
        "restore",
        "merge",
        "rebase",
        "stash",
        "clean",
        "cherry-pick",
        "revert",
        "tag"
      ],
      "reason": "Review agents are read-only."
    },
    {
      "id": "reviewer-no-file-write",
      "decision": "deny",
      "applies_to": [
        "*-review",
        "plan-review-*"
      ],
      "check": "writes_file",
      "reason": "Review agents are read-only."
    },
    {
      "id": "engineer-test-and-lint",
      "decision": "allow",
      "applies_to": [
        "software-engineer"
      ],
      "cmd": [
        "pytest",
        "ruff",
        "eslint",
        "oxlint",
        "prettier",
        "tsc",
        "vitest",
        "jest",
        "mypy"
      ],
      "reason": "Test and lint commands for the build step."
    },
    {
      "id": "allow-readonly-basic",
      "decision": "allow",
      "cmd": [
        "ls",
        "pwd",
        "cat",
        "head",
        "tail",
        "wc",
        "echo",
        "printf",
        "true",
        "false",
        "test",
        "[",
        "which",
        "type",
        "stat",
        "file",
        "basename",
        "dirname",
        "realpath",
        "date",
        "uname",
        "whoami",
        "id",
        "printenv",
        "diff",
        "cmp",
        "cut",
        "tr",
        "column",
        "jq",
        "grep",
        "egrep",
        "fgrep",
        "du",
        "df",
        "sleep",
        "cd",
        "pushd",
        "popd",
        "wait"
      ],
      "reason": "Read-only utility."
    },
    {
      "id": "allow-find-readonly",
      "decision": "allow",
      "cmd": "find",
      "args_none": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-fprint",
        "-fls",
        "-fprintf",
        "-fprint0",
        "-okdir"
      ],
      "reason": "find without an action that changes files."
    },
    {
      "id": "allow-sed-readonly",
      "decision": "allow",
      "cmd": "sed",
      "check": "sed_has_no_inplace",
      "reason": "sed without -i, -f, or a w/e script command."
    },
    {
      "id": "allow-git-readonly",
      "decision": "allow",
      "cmd": "git",
      "sub": [
        "status",
        "log",
        "diff",
        "show",
        "rev-parse",
        "rev-list",
        "ls-files",
        "ls-tree",
        "blame",
        "describe",
        "shortlog",
        "cat-file",
        "merge-base",
        "name-rev",
        "grep",
        "fetch",
        "check-ignore",
        "for-each-ref"
      ],
      "args_none": [
        "--set-upstream",
        "add",
        "set-url",
        "remove",
        "rm",
        "rename",
        "prune",
        "--unset"
      ],
      "reason": "git read or fetch.",
      "check": "git_args_are_read_only"
    },
    {
      "id": "allow-git-branch-list",
      "decision": "allow",
      "cmd": "git",
      "sub": "branch",
      "reason": "git branch listing.",
      "check": "git_branch_only_lists"
    },
    {
      "id": "allow-gh-readonly",
      "decision": "allow",
      "cmd": "gh",
      "regex": "^gh (pr|issue|run|release|repo|workflow) (view|list|status|checks|diff)\\b|^gh api (?!.*(-x|--method) )",
      "reason": "gh read.",
      "check": "gh_has_no_write_flag"
    },
    {
      "id": "allow-test-runners",
      "decision": "allow",
      "regex": "^(python3?|uv run python3?) -m (pytest|ruff|mypy)\\b|^(npm|pnpm|yarn) (test|run (test|lint|build|typecheck))\\b|^(npx )?(vitest|jest|eslint|oxlint|tsc)\\b|^shellcheck\\b",
      "reason": "Test, lint, typecheck.",
      "args_none": [
        "--fix",
        "--write",
        "-u",
        "--update-snapshot",
        "format",
        "--fix-dry-run"
      ]
    },
    {
      "id": "allow-repo-scripts",
      "decision": "allow",
      "regex": "^python3? (?!\\S*\\.\\.)(\\./)?(scripts|plugins/[\\w-]+/(scripts|hooks))/[\\w./-]+\\.py\\b",
      "reason": "Repo-owned Python scripts."
    }
  ]
}